<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ========== 视频层 ========== -->
    <xyz.doikki.videoplayer.player.VideoView
        android:id="@+id/mVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 切台截图层 -->
    <FrameLayout
        android:id="@+id/switchChannelSnapshotOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/switchChannelSnapshotImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- ========== 全屏手势触摸层 ========== -->
    <View
        android:id="@+id/gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- ========== 顶部切换按钮栏 ========== -->
    <LinearLayout
        android:id="@+id/top_button_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#88000000"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_program_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="节目单"
            android:textColor="@android:color/white"
            android:background="#DD333333"
            android:padding="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_channel_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="频道组"
            android:textColor="@android:color/white"
            android:background="#DD333333"
            android:padding="8dp"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ========== 左侧频道列表（三列） ========== -->
    <LinearLayout
        android:id="@+id/tvLeftChannnelListLayout"
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:background="#CC000000">

        <!-- 源列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSourceListView"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <!-- 分组列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGroupGridView"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <!-- 频道列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mChannelGridView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_current_source_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="当前源：测试源" />
    </LinearLayout>

    <!-- ========== 右侧设置面板（保留） ========== -->
    <LinearLayout
        android:id="@+id/tvRightSettingLayout"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:background="#CC000000">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingGroupView"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingItemView"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ========== 全屏节目单覆盖层 ========== -->
    <RelativeLayout
        android:id="@+id/ll_epg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <!-- 节目单日期选择 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mEpgDateGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:padding="10dp"
            android:background="#44000000" />

        <!-- 节目单列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/lv_epg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/mEpgDateGridView"
            android:padding="10dp" />

        <!-- 无节目提示 -->
        <TextView
            android:id="@+id/txtNoEpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="暂无节目信息"
            android:textColor="#AAAAAA"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- 加载动画 -->
        <ProgressBar
            android:id="@+id/ll_right_top_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- ========== 酷9风格底部信息栏（左右留边距） ========== -->
    <LinearLayout
        android:id="@+id/ll_bottom_info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#CC000000"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:elevation="4dp">

        <!-- 台标与频道信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/img_live_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside" />

                <FrameLayout
                    android:id="@+id/live_icon_null_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_circle_gray"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/live_icon_null_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_channel_bar_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_channel_bottom_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 节目信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_current_program_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFCC00"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_next_program_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 描述（可选） -->
        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

        <!-- 时间与进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_current_program_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/epg_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/epg_progress_drawable" />

            <TextView
                android:id="@+id/tv_next_program_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 回看控制器（保持不变） ========== -->
    <RelativeLayout
        android:id="@+id/backcontroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/pb_progressbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="80dp" />

        <TextView
            android:id="@+id/tv_currentpos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/pb_progressbar"
            android:layout_alignParentStart="true"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/pb_progressbar"
            android:layout_alignParentEnd="true"
            android:textColor="@android:color/white" />

        <View
            android:id="@+id/iv_playpause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/vod_pause" />

        <View
            android:id="@+id/iv_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:visibility="invisible"
            android:background="@drawable/icon_play" />
    </RelativeLayout>

    <!-- ========== 选台数字显示 ========== -->
    <TextView
        android:id="@+id/tv_selected_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:visibility="invisible" />

</FrameLayout>
